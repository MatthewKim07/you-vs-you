# Dependencies
node_modules/
jspm_packages/
bower_components/
web_modules/
.pnpm-store/
.npm/

# Build output and generated bundles
dist/
build/
out/
.output/
coverage/
.nyc_output/
*.lcov
*.tsbuildinfo
src/**/*.js
*.map

# Vite and tool caches
.vite/
node_modules/.vite/
.cache/
.parcel-cache/
.temp/
.tmp/
.eslintcache
.stylelintcache
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Git and editor metadata
.git/
.git/**
.DS_Store
.idea/
.vscode-test/

# Logs and diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Environment and local runtime files
.env
.env.*
!.env.example
*.pid
*.pid.lock
*.seed
.node_repl_history

# Package manager artifacts that are not useful for semantic indexing
package-lock.json
yarn.lock
pnpm-lock.yaml
*.tgz

# Test and browser automation artifacts
playwright-report/
test-results/
blob-report/
screenshots/
videos/
traces/

